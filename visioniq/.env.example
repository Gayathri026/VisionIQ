# ==============================================================================
# VISIONIQ: ENVIRONMENT CONFIGURATION
# Academic Final Year Project (23CSP701) | IEEE Access Submission
# ==============================================================================

# Application & Environment
PROJECT_NAME="VisionIQ: Adaptive Multi-Agent Vision Intelligence Framework"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Network Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./visioniq.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/visioniq"

# Dynamic Cost-Aware Routing Hyperparameters (Eq. 1 in Manuscript)
# Formulation: S(a, q) = alpha * R(a,q) + delta * E(a) - beta * C(a) - gamma * L(a)
# Constraint: alpha + beta + gamma + delta == 1.0
ROUTING_ALPHA=0.50
ROUTING_BETA=0.20
ROUTING_GAMMA=0.15
ROUTING_DELTA=0.15
ROUTING_THRESHOLD=0.45

# Storage & Directory Layout
STORAGE_DIR="storage"
UPLOAD_DIR="storage/uploads"
REPORTS_DIR="storage/reports"
MODEL_REGISTRY_DIR="ml/model_registry"
KNOWLEDGE_BASE_DIR="knowledge_base"

# Optional External API Keys (Graceful fallback to local CPU/offline heuristics)
GEMINI_API_KEY=""
