# VisionIQ Environment Configuration Example
PROJECT_NAME="VisionIQ: Adaptive Multi-Agent Vision Intelligence"
VERSION="1.0.0"
DEBUG=False

# Database
DATABASE_URL="sqlite:///./visioniq.db"

# Optional OpenAI API Key (deterministic fallback routing used if omitted)
# OPENAI_API_KEY="your-openai-api-key-here"

# Model Paths
MODEL_YOLO_PATH="backend/models/yolo11n.pt"
MODEL_PPE_PATH="backend/models/yolo_ppe.pt"
MODEL_DEFECT_PATH="backend/models/defect_model.pt"

# Cost-Aware Routing Calibration Parameters
ROUTING_ALPHA=0.50
ROUTING_BETA=0.20
ROUTING_GAMMA=0.15
ROUTING_DELTA=0.15
ROUTING_THRESHOLD=0.50
